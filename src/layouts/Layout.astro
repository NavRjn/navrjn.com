---
import { profile, mailto } from "../data/profile";
import Delights from "../components/Delights.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute path under /public, e.g. "/og.jpg"
  type?: "website" | "article";
  noindex?: boolean;
  markdown?: string; // path of the markdown twin of this page
  jsonLd?: Record<string, unknown>[];
}

const siteName = profile.name;
const {
  title = siteName,
  description = "Machine learning engineer in Vienna building computer vision and autonomous systems that work outside the lab. Available immediately.",
  image = "/og.jpg",
  type = "website",
  noindex = false,
  markdown,
  jsonLd = [],
} = Astro.props;

const fullTitle = title === siteName ? `${siteName} — ${profile.title}, Vienna` : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${profile.site}/#person`,
  name: profile.name,
  alternateName: profile.aliases,
  jobTitle: profile.title,
  description: profile.summary,
  url: profile.site,
  email: `mailto:${profile.email}`,
  image: new URL("/og.jpg", Astro.site).href,
  homeLocation: { "@type": "Place", name: "Vienna, Austria" },
  address: { "@type": "PostalAddress", addressLocality: "Vienna", addressCountry: "AT" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "Johannes Kepler University Linz" },
  knowsAbout: profile.knowsAbout,
  knowsLanguage: ["en", "de"],
  sameAs: [profile.links.github, profile.links.linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0b0c" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={profile.name} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Writing — Naveen Rajan" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...j })} />)}

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/">Naveen Rajan</a>

      <nav aria-label="Primary">
        <a href="/projects">Work</a>
        <a href="/writing">Writing</a>
        <a href="/about">About</a>
        <a class="nav-cv" href="/cv.pdf" download="Naveen-Rajan-CV.pdf">Résumé</a>
        <a class="nav-cta" href={mailto}>Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>© {new Date().getFullYear()} {profile.name} · {profile.email} · <a href="/now">Now</a></span>

      <div>
        <a href={profile.links.github}>GitHub</a>
        <a href={profile.links.linkedin}>LinkedIn</a>
        <a href={mailto}>Email</a>
      </div>
    </footer>
    <Delights />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b0b0c;
    color: #e7e7e7;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:hover) {
    color: #fff;
  }

  :global(main) {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #222;
  }

  .logo {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #888;
    font-size: 14px;
  }

  nav a {
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: #fff;
  }

  nav .nav-cta {
    padding: 6px 12px;
    border: 1px solid #e3e7df;
    border-radius: 3px;
    background: #e3e7df;
    color: #141515;
    font-weight: 550;
  }

  nav .nav-cta:hover {
    background: #fff;
    color: #111;
  }

  footer {
    width: min(900px, calc(100% - 40px));
    margin: 100px auto 40px;
    padding-top: 24px;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 13px;
  }

  footer div {
    display: flex;
    gap: 18px;
  }

  footer a:hover {
    color: #aaa;
  }

  @media (max-width: 600px) {
    .site-header {
      align-items: center;
      gap: 12px;
    }

    nav {
      gap: 12px;
      font-size: 13px;
    }

    nav .nav-cv {
      display: none;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
