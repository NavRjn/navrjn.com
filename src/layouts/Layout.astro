---
interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute path under /public, e.g. "/og.jpg"
}

const siteName = "Naveen Rajan";
const {
  title = siteName,
  description = "Machine learning engineer in Vienna building computer vision and autonomous systems that work outside the lab. Open to full-time roles.",
  image = "/og.jpg",
} = Astro.props;

const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteName,
  jobTitle: "Machine Learning Engineer",
  url: "https://navrjn.com",
  email: "mailto:hello@navrjn.com",
  image: new URL("/og.jpg", Astro.site).href,
  address: { "@type": "PostalAddress", addressLocality: "Vienna", addressCountry: "AT" },
  sameAs: ["https://github.com/navrjn", "https://www.linkedin.com/in/navrjn"],
};

const mailto = "mailto:hello@navrjn.com?subject=Opportunity%20%E2%80%94%20Naveen%20Rajan";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/">Naveen Rajan</a>

      <nav aria-label="Primary">
        <a href="/projects">Work</a>
        <a href="/about">About</a>
        <a href="/cv.pdf" download="Naveen-Rajan-CV.pdf">Résumé</a>
        <a class="nav-cta" href={mailto}>Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Naveen Rajan · hello@navrjn.com</span>

      <div>
        <a href="https://github.com/navrjn">GitHub</a>
        <a href="https://www.linkedin.com/in/navrjn">LinkedIn</a>
        <a href={mailto}>Email</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b0b0c;
    color: #e7e7e7;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:hover) {
    color: #fff;
  }

  :global(main) {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #222;
  }

  .logo {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    color: #888;
    font-size: 14px;
  }

  nav a {
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: #fff;
  }

  nav .nav-cta {
    padding: 6px 12px;
    border: 1px solid #e3e7df;
    border-radius: 3px;
    background: #e3e7df;
    color: #141515;
    font-weight: 550;
  }

  nav .nav-cta:hover {
    background: #fff;
    color: #111;
  }

  footer {
    width: min(900px, calc(100% - 40px));
    margin: 100px auto 40px;
    padding-top: 24px;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 13px;
  }

  footer div {
    display: flex;
    gap: 18px;
  }

  footer a:hover {
    color: #aaa;
  }

  @media (max-width: 600px) {
    .site-header {
      align-items: center;
      gap: 12px;
    }

    nav {
      gap: 12px;
      font-size: 13px;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
