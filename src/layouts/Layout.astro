---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Naveen Rajan",
  description = "Engineer, founder, and researcher working at the intersection of SciML, CV, an embodied robotics.",
} = Astro.props;

const siteName = "Naveen Rajan";
const fullTitle = title === siteName ? siteName : `${title} — ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="icon" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/">Naveen Rajan</a>

      <nav>
        <a href="/writing">Writing</a>
        <a href="/projects">Projects</a>
        <a href="/about">About</a>
        <a href="/now">Now</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <span>© {new Date().getFullYear()} Naveen Rajan</span>

      <div>
        <a href="https://github.com/navrjn">GitHub</a>
        <a href="https://linkedin/in/navrjn">LinkedIn</a>
        <a href="mailto:hello@navrjn.com">Email</a>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0b0b0c;
    color: #e7e7e7;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    font-size: 16px;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:hover) {
    color: #fff;
  }

  :global(main) {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    width: min(900px, calc(100% - 40px));
    margin: 0 auto;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #222;
  }

  .logo {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  nav {
    display: flex;
    gap: 22px;
    color: #888;
    font-size: 14px;
  }

  nav a {
    transition: color 0.15s ease;
  }

  nav a:hover {
    color: #fff;
  }

  footer {
    width: min(900px, calc(100% - 40px));
    margin: 100px auto 40px;
    padding-top: 24px;
    border-top: 1px solid #222;
    display: flex;
    justify-content: space-between;
    color: #666;
    font-size: 13px;
  }

  footer div {
    display: flex;
    gap: 18px;
  }

  footer a:hover {
    color: #aaa;
  }

  @media (max-width: 600px) {
    .site-header {
      align-items: flex-start;
      gap: 20px;
    }

    nav {
      gap: 12px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    footer {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
