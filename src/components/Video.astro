---
// Either a self-hosted file under /public (src) or a YouTube video id (youtube).
interface Props {
  src?: string;
  poster?: string;
  youtube?: string;
  title: string;
  caption?: string;
}
const { src, poster, youtube, title, caption } = Astro.props;
---

<figure>
  <div class="frame">
    {youtube ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtube}`}
        title={title}
        loading="lazy"
        allow="encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
    ) : (
      <video controls muted playsinline preload="none" poster={poster} aria-label={title}>
        <source src={src} />
      </video>
    )}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 32px 0;
  }
  .frame {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid #29292d;
    border-radius: 4px;
    background: #101012;
  }
  video,
  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  figcaption {
    margin-top: 10px;
    color: #77777e;
    font-size: 12px;
    line-height: 1.6;
  }
</style>
