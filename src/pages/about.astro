---
import Layout from "../layouts/Layout.astro";
import { profile, mailto } from "../data/profile";
---

<Layout
  title="About"
  description="Naveen Rajan is a machine learning engineer in Vienna: computer vision, autonomous drone navigation, LLM document intelligence and physics-informed ML. BSc AI at JKU Linz. Available immediately."
  markdown="/about.md"
>
  <div class="page">
    <p class="eyebrow">ABOUT</p>
    <h1>ML engineer. Vienna.</h1>

    <p class="lead">{profile.summary}</p>
    <p class="status"><span class="dot"></span>{profile.availability}. {profile.lookingFor}</p>

    <section>
      <h2>Experience</h2>
      <ol class="timeline">
        {profile.experience.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.title} <span class="org">· {e.org}</span></h3>
              <p>{e.summary}</p>
              {e.steps.length > 0 && (
                <ul class="steps">
                  {e.steps.map((st) => <li><b>{st.period}</b> {st.text}</li>)}
                </ul>
              )}
              {e.bullets.length > 0 && (
                <p class="sub">Selected impact</p>
                <ul class="bullets">{e.bullets.map((b) => <li>{b}</li>)}</ul>
              )}
            </div>
          </li>
        ))}
        {profile.education.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.title} <span class="org">· {e.org}</span></h3>
              <p>{e.summary}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="more">See the <a href="/projects">projects</a> for architecture and results, or the <a href="/cv.pdf" download="Naveen-Rajan-CV.pdf">résumé (PDF)</a>.</p>
    </section>

    <section>
      <h2>How I work</h2>
      <p>{profile.workingStyle}</p>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {profile.skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items.join(", ")}</dd>
          </div>
        ))}
        <div>
          <dt>Languages (spoken)</dt>
          <dd>{profile.languages.map((l) => `${l.name} (${l.level})`).join(", ")}</dd>
        </div>
      </dl>
    </section>

    <section>
      <h2>Recognition & press</h2>
      <ul class="press">
        {profile.awards.map((a) => <li>{a}</li>)}
        {profile.press.map((p) => (
          <li><a href={p.url} target="_blank" rel="noreferrer">{p.outlet}: {p.title} ↗</a></li>
        ))}
      </ul>
    </section>

    <section>
      <h2>What I'm looking for</h2>
      <p>
        {profile.lookingFor} I'm also glad to talk to founders and partners about early-stage
        technical ideas.
      </p>
    </section>

    <section class="cta">
      <a class="button" href={mailto}>Email me ↗</a>
      <a href="/cv.pdf" download="Naveen-Rajan-CV.pdf">Résumé (PDF) ↓</a>
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </section>
  </div>
</Layout>

<style>
  .page {
    padding: 64px 0 0;
    max-width: 720px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: #b4c9a9;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .lead {
    margin: 22px 0 0;
    color: #c4c4c9;
    font-size: 18px;
  }
  section {
    margin-top: 56px;
  }
  h2 {
    margin: 0 0 18px;
    color: #a0a0a5;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  section > p {
    margin: 0;
    color: #b0b0b6;
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline > li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid #29292d;
  }
  .period {
    color: #77777e;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .org {
    color: #8c8c92;
    font-weight: 400;
  }
  .timeline p {
    margin: 0;
    color: #a1a1a7;
    font-size: 14px;
  }
  .skills {
    margin: 0;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 14px 0;
    border-top: 1px solid #29292d;
  }
  .skills dt {
    color: #d8d8dc;
    font-size: 14px;
    font-weight: 550;
  }
  .skills dd {
    margin: 0;
    color: #a1a1a7;
    font-size: 14px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    color: #bcbcc1;
  }
  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 16px;
    border-radius: 3px;
    background: #e3e7df;
    color: #141515;
    font-size: 13px;
    font-weight: 550;
  }
  .button:hover {
    background: #fff;
    color: #111;
  }
  @media (max-width: 600px) {
    .page {
      padding-top: 40px;
    }
    .timeline > li,
    .skills > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }

  .status { display: flex; gap: 10px; align-items: baseline; margin: 18px 0 0; color: #a1a1a7; font-size: 14px; }
  .dot { flex: 0 0 auto; width: 7px; height: 7px; border-radius: 50%; background: #b4c9a9; transform: translateY(-1px); }
  .steps, .bullets { margin: 12px 0 0; padding-left: 18px; color: #a1a1a7; font-size: 14px; }
  .steps li, .bullets li { margin: 6px 0; display: list-item; }
  .steps b { color: #d8d8dc; font-weight: 550; font-variant-numeric: tabular-nums; }
  .more, .press { color: #a1a1a7; font-size: 14px; }
  .press { margin: 0; padding-left: 18px; }
  section a:not(.button) { color: #d5e2cc; text-decoration: underline; text-underline-offset: 3px; }
  .cta a:not(.button) { text-decoration: none; }
  .sub { margin: 18px 0 0 !important; color: #77777e !important; font-size: 11px !important; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
