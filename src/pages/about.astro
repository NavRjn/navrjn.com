---
import Layout from "../layouts/Layout.astro";

const mailto =
  "mailto:hello@navrjn.com?subject=Opportunity%20%E2%80%94%20Naveen%20Rajan";

// TODO: add employer titles, degree + institution + dates here. Only add facts that are true.
const experience = [
  {
    period: "2021 — Present",
    title: "Perception & navigation lead",
    org: "Flying4Home / ClearBee",
    summary:
      "Led perception and navigation for a drone platform: classical computer vision, monocular depth, deep learning, sensor fusion, and recovery policies for GPS-denied operation.",
  },
  {
    period: "2025 — Present",
    title: "Scientific ML research",
    org: "Independent",
    summary:
      "Building a reproducible experimentation framework for physics-informed neural networks, studying latent-space manifolds to cover families of under-determined industrial simulations with a single model.",
  },
];

const skills = [
  { group: "ML & vision", items: "Computer vision, monocular depth, deep learning, PINNs, information extraction" },
  { group: "Robotics & edge", items: "Sensor fusion, recovery policies, real-time software, constrained hardware" },
  { group: "Languages & tools", items: "Python, PyTorch, CLI tooling, reproducible training workflows" },
];
---

<Layout
  title="About"
  description="Naveen Rajan is a machine learning engineer in Vienna with experience in computer vision, autonomous drone navigation and scientific ML."
>
  <div class="page">
    <p class="eyebrow">ABOUT</p>
    <h1>ML engineer. Vienna.</h1>

    <p class="lead">
      I build computer vision and ML systems that have to work on real hardware
      under real constraints. Most of my time goes into perception and
      navigation for drones; alongside that I work on applied LLM tooling and
      physics-informed neural networks.
    </p>

    <section>
      <h2>Experience</h2>
      <ol class="timeline">
        {experience.map((e) => (
          <li>
            <span class="period">{e.period}</span>
            <div>
              <h3>{e.title} <span class="org">· {e.org}</span></h3>
              <p>{e.summary}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Skills</h2>
      <dl class="skills">
        {skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>{s.items}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2>What I'm looking for</h2>
      <p>
        A full-time ML or computer-vision engineering role on a team shipping
        technically ambitious products, in Vienna or remote within the EU. I'm
        also happy to talk about early-stage ideas.
      </p>
    </section>

    <section class="cta">
      <a class="button" href={mailto}>Email me ↗</a>
      <a href="/cv.pdf" download="Naveen-Rajan-CV.pdf">Résumé (PDF) ↓</a>
      <a href="https://www.linkedin.com/in/navrjn" target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a href="https://github.com/navrjn" target="_blank" rel="noreferrer">GitHub ↗</a>
    </section>
  </div>
</Layout>

<style>
  .page {
    padding: 64px 0 0;
    max-width: 720px;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: #b4c9a9;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .lead {
    margin: 22px 0 0;
    color: #c4c4c9;
    font-size: 18px;
  }
  section {
    margin-top: 56px;
  }
  h2 {
    margin: 0 0 18px;
    color: #a0a0a5;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  section > p {
    margin: 0;
    color: #b0b0b6;
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid #29292d;
  }
  .period {
    color: #77777e;
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .timeline h3 {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: -0.02em;
  }
  .org {
    color: #8c8c92;
    font-weight: 400;
  }
  .timeline p {
    margin: 0;
    color: #a1a1a7;
    font-size: 14px;
  }
  .skills {
    margin: 0;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 14px 0;
    border-top: 1px solid #29292d;
  }
  .skills dt {
    color: #d8d8dc;
    font-size: 14px;
    font-weight: 550;
  }
  .skills dd {
    margin: 0;
    color: #a1a1a7;
    font-size: 14px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    color: #bcbcc1;
  }
  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 16px;
    border-radius: 3px;
    background: #e3e7df;
    color: #141515;
    font-size: 13px;
    font-weight: 550;
  }
  .button:hover {
    background: #fff;
    color: #111;
  }
  @media (max-width: 600px) {
    .page {
      padding-top: 40px;
    }
    .timeline li,
    .skills > div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
