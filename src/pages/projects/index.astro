---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Work"
  description="Selected ML, computer vision and autonomous-systems projects by Naveen Rajan."
>
  <div class="page">
    <p class="eyebrow">WORK</p>
    <h1>Systems I've built.</h1>
    <p class="intro">
      Perception and autonomy on real hardware, applied LLM tooling, and scientific ML research.
    </p>

    <div class="projects">
      {projects.map((p, i) => <ProjectCard project={p} featured={i === 0} />)}
    </div>
  </div>
</Layout>

<style>
  .page {
    padding: 64px 0 0;
  }
  .eyebrow {
    margin: 0 0 16px;
    color: #b4c9a9;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .intro {
    max-width: 560px;
    margin: 18px 0 40px;
    color: #a1a1a7;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  @media (max-width: 600px) {
    .page {
      padding-top: 40px;
    }
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
