---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Figure from '../../components/Figure.astro';
import Video from '../../components/Video.astro';
import Demo from '../../components/Demo.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects'))
    .filter((p) => !p.data.draft)
    .sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1], next: all[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const mailto = `mailto:hello@navrjn.com?subject=${encodeURIComponent(`Re: ${data.title}`)}`;
---

<Layout title={data.title} description={data.summary}>
  <article class="page">
    <a class="back" href="/projects">← All work</a>
    <p class="eyebrow">{data.type}</p>
    <h1>{data.title}</h1>
    <p class="summary">{data.summary}</p>

    <dl class="facts">
      <div><dt>Role</dt><dd>{data.role}</dd></div>
      <div><dt>Period</dt><dd>{data.period}</dd></div>
      {data.stack.length > 0 && <div><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></div>}
      {data.metric && <div><dt>Outcome</dt><dd>{data.metric.value} {data.metric.label}</dd></div>}
    </dl>

    {(data.links.repo || data.links.demo || data.links.video) && (
      <p class="links">
        {data.links.repo && <a href={data.links.repo} target="_blank" rel="noreferrer">Repository ↗</a>}
        {data.links.demo && <a href={data.links.demo} target="_blank" rel="noreferrer">Live demo ↗</a>}
        {data.links.video && <a href={data.links.video} target="_blank" rel="noreferrer">Video ↗</a>}
      </p>
    )}

    <div class="body">
      <Content components={{ Figure, Video, Demo }} />
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/projects/${next.id}`}>{next.data.title} →</a> : <span></span>}
    </nav>

    <section class="cta">
      <h2>Working on something similar?</h2>
      <p>I'm open to full-time ML and computer-vision roles. Vienna, on-site or remote (EU).</p>
      <a class="button" href={mailto}>Email me ↗</a>
    </section>
  </article>
</Layout>

<style>
  .page {
    padding: 48px 0 0;
  }
  .back {
    color: #888;
    font-size: 13px;
  }
  .eyebrow {
    margin: 32px 0 14px;
    color: #b4c9a9;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }
  h1 {
    margin: 0;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.05em;
  }
  .summary {
    max-width: 680px;
    margin: 18px 0 0;
    color: #b0b0b6;
    font-size: 17px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 20px;
    margin: 32px 0 0;
    padding: 20px 0;
    border-top: 1px solid #29292d;
    border-bottom: 1px solid #29292d;
  }
  .facts dt {
    color: #77777e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .facts dd {
    margin: 4px 0 0;
    color: #d8d8dc;
    font-size: 14px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 20px 0 0;
    font-size: 14px;
  }
  .body {
    max-width: 720px;
    margin-top: 40px;
    color: #c4c4c9;
  }
  .body :global(h2) {
    margin: 44px 0 12px;
    color: #ededed;
    font-size: 24px;
    font-weight: 570;
    letter-spacing: -0.035em;
  }
  .body :global(a) {
    color: #d5e2cc;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid #29292d;
    color: #a1a1a7;
    font-size: 14px;
  }
  .cta {
    margin-top: 56px;
    padding: 32px;
    border: 1px solid #29292d;
    border-radius: 4px;
    background: #101012;
  }
  .cta h2 {
    margin: 0 0 8px;
    font-size: 24px;
    letter-spacing: -0.04em;
  }
  .cta p {
    margin: 0 0 20px;
    color: #a1a1a7;
    font-size: 14px;
  }
  .button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 16px;
    border-radius: 3px;
    background: #e3e7df;
    color: #141515;
    font-size: 13px;
    font-weight: 550;
  }
  .button:hover {
    background: #fff;
    color: #111;
  }
</style>
