---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not yet" noindex>
  <div class="not-yet-wrap">
    <div class="pill">⏳ STATUS: STILL COOKING</div>

    <h1>Not yet.</h1>

    <p id="context-msg">
      You caught me mid-commit. That page is currently a chaotic mess of half-written markdown and caffeinated sticky notes.
    </p>

    <div class="progress-box">
      <div class="progress-label">
        <span>Drafting & sanity-checking</span>
        <span id="percent">68%</span>
      </div>
      <div class="bar-bg">
        <div class="bar-fill" id="bar"></div>
      </div>
      <button id="poke-btn" type="button">Poke the developer to type faster ⚡</button>
    </div>

    <a href="/" class="back-link">← Back to safety (Home)</a>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const from = params.get('from');
  const msg = document.getElementById('context-msg');

  if (from && msg) {
    const code = document.createElement('code');
    code.textContent = from;
    msg.replaceChildren(
      'You tried to peek at ', code,
      ", but it's still in the oven. Check back soon. I promise it won't be placeholder lorem ipsum."
    );
  }

  let pct = 68;
  const btn = document.getElementById('poke-btn');
  const pctEl = document.getElementById('percent');
  const barEl = document.getElementById('bar');

  const snark = [
    "Typing faster...",
    "Drinking more espresso...",
    "Fixing a weird LaTeX bug...",
    "Deleting a paragraph that sounded too pretentious...",
    "Okay, now you're just spamming me. (99.9%)"
  ];
  let clicks = 0;

  btn?.addEventListener('click', () => {
    pct = Math.min(99.9, +(pct + (100 - pct) * 0.35).toFixed(1));
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (barEl) barEl.style.width = `${pct}%`;
    if (btn) btn.textContent = snark[Math.min(clicks, snark.length - 1)];
    clicks++;
  });
</script>

<style>
  .not-yet-wrap {
    max-width: 38rem;
    margin: 6rem auto;
    padding: 0 1.5rem;
  }

  .pill {
    display: inline-block;
    font-family: monospace;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border: 1px dashed currentColor;
    border-radius: 4px;
    opacity: 0.7;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 3rem;
    margin: 0 0 1rem 0;
  }

  p {
    line-height: 1.6;
    opacity: 0.85;
  }

  code {
    font-family: monospace;
    padding: 0.15rem 0.4rem;
    background: rgba(128, 128, 128, 0.15);
    border-radius: 4px;
  }

  .progress-box {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid rgba(128, 128, 128, 0.25);
    border-radius: 8px;
  }

  .progress-label {
    display: flex;
    justify-content: space-between;
    font-family: monospace;
    font-size: 0.8rem;
    margin-bottom: 0.5rem;
  }

  .bar-bg {
    height: 8px;
    background: rgba(128, 128, 128, 0.15);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .bar-fill {
    width: 68%;
    height: 100%;
    background: currentColor;
    transition: width 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  #poke-btn {
    width: 100%;
    padding: 0.6rem;
    font-family: monospace;
    font-size: 0.8rem;
    background: transparent;
    color: inherit;
    border: 1px solid rgba(128, 128, 128, 0.4);
    border-radius: 6px;
    cursor: pointer;
  }

  #poke-btn:hover {
    border-color: currentColor;
  }

  .back-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
</style>