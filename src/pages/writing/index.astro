---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = (await getCollection("writing"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" }).toUpperCase();
---

<Layout
  title="Writing"
  description="Engineering notes by Naveen Rajan on real-time Kotlin systems, observability for robotics, and testing LLM pipelines."
  markdown="/llms-full.txt"
>
  <div class="page">
    <p class="eyebrow">WRITING</p>
    <h1>Engineering notes.</h1>
    <p class="intro">Short, practical write-ups from systems I've built: real-time control, debugging, and testing.</p>

    <div class="articles">
      {posts.map((p) => (
        <a href={`/writing/${p.id}`} class="article">
          <span class="date">{fmt(p.data.date)}</span>
          <div>
            <h2>{p.data.title}</h2>
            <p>{p.data.summary}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <p class="rss"><a href="/rss.xml">RSS feed</a></p>
  </div>
</Layout>

<style>
  .page { padding: 64px 0 0; }
  .eyebrow { margin: 0 0 16px; color: #b4c9a9; font-size: 12px; font-weight: 600; letter-spacing: 0.13em; }
  h1 { margin: 0; font-size: clamp(34px, 5vw, 52px); font-weight: 600; line-height: 1.1; letter-spacing: -0.05em; }
  .intro { max-width: 560px; margin: 18px 0 40px; color: #a1a1a7; }
  .article { display: grid; grid-template-columns: 100px 1fr 30px; gap: 20px; padding: 26px 0; border-top: 1px solid #29292d; }
  .article:last-of-type { border-bottom: 1px solid #29292d; }
  .article:hover h2 { color: #fff; }
  .date { color: #77777e; font-size: 11px; letter-spacing: 0.08em; padding-top: 5px; }
  h2 { margin: 0; font-size: 19px; font-weight: 560; letter-spacing: -0.02em; color: #ededed; }
  .article p { margin: 6px 0 0; color: #a1a1a7; font-size: 14px; }
  .article > span:last-child { color: #77777e; }
  .rss { margin-top: 20px; font-size: 13px; color: #77777e; }
  @media (max-width: 600px) {
    .page { padding-top: 40px; }
    .article { grid-template-columns: 1fr 25px; }
    .date { display: none; }
  }
</style>
