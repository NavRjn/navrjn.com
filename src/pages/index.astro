---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import portrait from "../assets/me-3.jpg";

const featured = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const mailto =
  "mailto:hello@navrjn.com?subject=Opportunity%20%E2%80%94%20Naveen%20Rajan";
---

<Layout
  title="Naveen Rajan"
  description="Machine learning engineer in Vienna building computer vision and autonomous systems that work outside the lab. Open to full-time roles."
>
  <section class="hero">
    <div class="hero-eyebrow">
      <span class="status-dot"></span>
      <span>MACHINE LEARNING ENGINEER</span>
      <span class="eyebrow-separator">/</span>
      <span>VIENNA</span>
    </div>

    <div class="hero-stage">
      <div class="hero-content">
        <p class="hero-kicker">COMPUTER VISION · AUTONOMOUS SYSTEMS</p>

        <h1>
          I build ML systems that
          <span>work outside the lab.</span>
        </h1>

        <p class="intro">
          Since 2021 I've led perception and navigation for a drone platform:
          classical vision, monocular depth, deep learning and sensor fusion
          under real-time, GPS-denied constraints.
        </p>

        <p class="hero-secondary">
          Also: applied LLM document intelligence and physics-informed neural
          networks.
        </p>

        <div class="hero-actions">
          <a class="button-primary" href={mailto}>
            Email me <span aria-hidden="true">↗</span>
          </a>
          <a
            class="button-secondary"
            href="/cv.pdf"
            download="Naveen-Rajan-CV.pdf"
          >
            Résumé (PDF) <span aria-hidden="true">↓</span>
          </a>
          <a
            class="button-secondary"
            href="https://www.linkedin.com/in/navrjn"
            target="_blank"
            rel="noreferrer"
          >
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-meta">
          <span class="location-dot"></span>
          Vienna · on-site or remote (EU)
          <span class="meta-divider">·</span>
          Open to full-time roles
        </div>
      </div>

      <div class="hero-image">
        <Image
          src={portrait}
          alt="Portrait of Naveen Rajan"
          class="portrait"
          widths={[480, 800, 1100]}
          sizes="(max-width: 600px) 100vw, 40vw"
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
        <div class="image-caption">
          <span>NAVEEN RAJAN</span>
          <span>ML ENGINEER</span>
        </div>
      </div>
    </div>
  </section>

  <section class="now-section" aria-labelledby="bring-heading">
    <div class="section-label" id="bring-heading">
      <span>01</span>
      WHAT I BRING
    </div>

    <div class="now-grid">
      <article class="now-item">
        <span class="now-index">PERCEPTION &amp; AUTONOMY</span>
        <h2>Vision on real hardware</h2>
        <p>
          Visual perception, sensor fusion and recovery policies on
          constrained edge hardware, flown rather than simulated.
        </p>
      </article>

      <article class="now-item">
        <span class="now-index">APPLIED LLM / NLP</span>
        <h2>Document intelligence</h2>
        <p>
          Entity extraction and resolution, with evaluation and reviewable
          outputs, for legal-style unstructured corpora.
        </p>
      </article>

      <article class="now-item">
        <span class="now-index">SCIENTIFIC ML</span>
        <h2>Physics-informed models</h2>
        <p>
          Reproducible PINN experimentation: one model covering a family of
          under-determined industrial simulations.
        </p>
      </article>
    </div>
  </section>

  <section class="content-section" id="selected-work">
    <div class="section-heading">
      <div>
        <div class="section-label">
          <span>02</span>
          SELECTED WORK
        </div>
        <h2 class="section-title">Built, tested, learned.</h2>
      </div>

      <a class="section-link" href="/projects">
        All work <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="projects">
      {featured.map((p, i) => <ProjectCard project={p} featured={i === 0} />)}
    </div>
  </section>

  <section class="contact-section" id="contact">
    <div>
      <div class="section-label">
        <span>03</span>
        GET IN TOUCH
      </div>

      <h2>Hiring for CV or ML? Let's talk.</h2>

      <p>
        I'm looking for a full-time role on a team building technically
        ambitious products. The fastest way to reach me is
        <a class="mail-inline" href={mailto}>hello@navrjn.com</a>.
      </p>
    </div>

    <div class="contact-actions">
      <a href={mailto}>Email me ↗</a>
      <a
        href="https://www.linkedin.com/in/navrjn"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn ↗
      </a>
      <a href="https://github.com/navrjn" target="_blank" rel="noreferrer">
        GitHub ↗
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-top: 36px;
  }

  .hero-eyebrow,
  .section-label,
  .hero-kicker,
  .now-index {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.13em;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 11px;
    color: #c0c0c4;
    font-size: 13px;
    letter-spacing: 0.09em;
  }

  .status-dot,
  .location-dot {
    display: inline-block;
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #b4c9a9;
  }

  .eyebrow-separator {
    color: #505056;
  }

  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: center;
    position: relative;
    min-height: 590px;
    margin-top: 22px;
    padding: 24px 0 48px;
    isolation: isolate;
  }

  .hero-image {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    z-index: 1;
    width: 100%;
    height: clamp(420px, 49vw, 560px);
    overflow: hidden;
    border: 1px solid #29292d;
    border-radius: 5px;
    background: #171719;
  }

  .hero-image :global(.portrait) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: saturate(0.78);
  }

  .hero-image::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 65%,
      rgba(0, 0, 0, 0.52) 100%
    );
  }

  .image-caption {
    position: absolute;
    z-index: 2;
    bottom: 18px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #e4e4e4;
    font-size: 10px;
    letter-spacing: 0.11em;
  }

  .hero-content {
    grid-column: 1 / -1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    width: min(760px, 72%);
    margin-right: auto;
    padding: clamp(28px, 4.5vw, 52px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 5px;
    background: rgba(15, 15, 17, 0.84);
    -webkit-backdrop-filter: blur(22px) saturate(115%);
    backdrop-filter: blur(22px) saturate(115%);
    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.18);
  }

  .hero-kicker {
    margin: 0 0 23px;
    color: #b4c9a9;
    font-size: 11px;
  }

  h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(38px, 5vw, 64px);
    font-weight: 620;
    line-height: 1.04;
    letter-spacing: -0.06em;
  }

  h1 span {
    display: block;
    margin-top: 5px;
    color: #929298;
  }

  .intro {
    max-width: 540px;
    margin: 26px 0 0;
    color: #e0e0e2;
    font-size: clamp(16px, 1.5vw, 18px);
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .hero-secondary {
    max-width: 480px;
    margin: 12px 0 0;
    color: #96969c;
    font-size: 14px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 29px;
  }

  .button-primary,
  .button-secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 10px 15px;
    border: 1px solid #414146;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 550;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .button-primary {
    background: #e3e7df;
    border-color: #e3e7df;
    color: #141515;
  }

  .button-primary:hover {
    background: #fff;
    border-color: #fff;
    color: #111;
  }

  .button-secondary {
    background: rgba(255, 255, 255, 0.025);
    color: #e5e5e7;
  }

  .button-secondary:hover {
    border-color: #88888e;
    background: rgba(255, 255, 255, 0.07);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    margin-top: 28px;
    color: #a1a1a6;
    font-size: 12px;
  }

  .location-dot {
    width: 6px;
    height: 6px;
  }

  .meta-divider {
    color: #55555a;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #a0a0a5;
    font-size: 11px;
  }

  .section-label > span {
    color: #b4c9a9;
    font-variant-numeric: tabular-nums;
  }

  .now-section {
    margin-top: 14px;
    padding: 30px 0 34px;
    border-top: 1px solid #29292d;
    border-bottom: 1px solid #29292d;
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 38px;
    margin-top: 28px;
  }

  .now-index {
    color: #74747b;
    font-size: 10px;
    letter-spacing: 0.11em;
  }

  .now-item h2 {
    margin: 10px 0 7px;
    font-size: 18px;
    font-weight: 560;
    letter-spacing: -0.035em;
  }

  .now-item p {
    max-width: 310px;
    margin: 0;
    color: #9a9aa0;
    font-size: 14px;
    line-height: 1.8;
  }

  .content-section {
    margin-top: 96px;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }

  .section-title {
    margin: 12px 0 0;
    font-size: clamp(27px, 3.5vw, 38px);
    font-weight: 570;
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  .section-link {
    flex-shrink: 0;
    padding-bottom: 4px;
    color: #b7b7bc;
    font-size: 13px;
  }

  .section-link:hover {
    color: #fff;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .contact-section {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 36px;
    margin-top: 96px;
    padding-top: 36px;
    border-top: 1px solid #29292d;
  }

  .contact-section h2 {
    max-width: 620px;
    margin: 16px 0 12px;
    font-size: clamp(28px, 3.5vw, 39px);
    font-weight: 570;
    line-height: 1.15;
    letter-spacing: -0.05em;
  }

  .contact-section > div > p {
    max-width: 620px;
    margin: 0;
    color: #a1a1a7;
    font-size: 14px;
    line-height: 1.85;
  }

  .mail-inline {
    color: #d5e2cc;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-actions {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding-bottom: 4px;
  }

  .contact-actions a {
    color: #bcbcc1;
    font-size: 13px;
  }

  .contact-actions a:hover {
    color: #fff;
  }

  @media (min-width: 1200px) {
    .hero-stage {
      min-height: 620px;
    }
  }

  @media (max-width: 850px) {
    .hero-stage {
      min-height: 510px;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    }

    .hero-content {
      width: 82%;
      padding: 30px;
    }

    .hero-image {
      height: 450px;
    }

    .now-grid {
      gap: 22px;
    }
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 28px;
    }

    .hero-eyebrow {
      gap: 7px;
      font-size: 10px;
      letter-spacing: 0.06em;
    }

    .hero-stage {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: 0;
      margin-top: 20px;
      padding: 0 0 10px;
    }

    .hero-image {
      order: 0;
      width: 100%;
      height: clamp(280px, 80vw, 380px);
    }

    .hero-image :global(.portrait) {
      object-position: center 32%;
    }

    .image-caption {
      left: 14px;
      right: 14px;
      bottom: 13px;
      font-size: 9px;
    }

    .hero-content {
      order: 1;
      width: calc(100% - 20px);
      margin: -45px 0 0;
      padding: 25px 22px 23px;
      align-self: flex-start;
      background: rgba(15, 15, 17, 0.92);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
    }

    .hero-kicker {
      margin-bottom: 17px;
      font-size: 10px;
    }

    h1 {
      font-size: clamp(34px, 9.5vw, 48px);
      line-height: 1.05;
    }

    .intro {
      margin-top: 19px;
      font-size: 15px;
      line-height: 1.7;
    }

    .hero-secondary {
      font-size: 13px;
    }

    .hero-actions {
      gap: 10px;
      margin-top: 23px;
    }

    .button-primary {
      width: 100%;
    }

    .button-primary,
    .button-secondary {
      gap: 10px;
      padding-inline: 12px;
      font-size: 12px;
    }

    .hero-meta {
      gap: 7px;
      margin-top: 22px;
      font-size: 11px;
    }

    .now-section {
      margin-top: 25px;
      padding: 24px 0;
    }

    .now-grid {
      grid-template-columns: 1fr;
      gap: 23px;
      margin-top: 23px;
    }

    .now-item h2 {
      margin-top: 7px;
      font-size: 17px;
    }

    .now-item p {
      max-width: 440px;
      font-size: 13px;
    }

    .content-section,
    .contact-section {
      margin-top: 68px;
    }

    .section-heading {
      gap: 12px;
      margin-bottom: 20px;
    }

    .section-title {
      font-size: 29px;
    }

    .section-link {
      font-size: 12px;
    }

    .projects {
      grid-template-columns: 1fr;
      gap: 11px;
    }

    .contact-section h2 {
      font-size: 30px;
    }

    .contact-section {
      align-items: flex-start;
      flex-direction: column;
      gap: 24px;
    }

    .contact-actions {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-primary,
    .button-secondary {
      transition: none;
    }
  }
</style>
