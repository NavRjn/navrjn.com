---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Now"
  description="What I'm currently working on, learning, and thinking about."
>
  <div class="page">
    <p class="eyebrow">NOW</p>

    <h1>What I'm up to.</h1>

    <p class="updated">Last updated September 2026.</p>

    <section>
      <h2>Building</h2>
      <p>
        Currently working on projects around AI and software.
      </p>
    </section>

    <section>
      <h2>Learning</h2>
      <p>
        Studying modern AI systems, engineering, and the ideas
        surrounding them.
      </p>
    </section>

    <section>
      <h2>Exploring</h2>
      <p>
        Looking for interesting problems where technology can create
        genuinely new possibilities.
      </p>
    </section>
  </div>
</Layout>

<style>
  .page {
    padding: 90px 0;
    max-width: 700px;
  }

  .eyebrow {
    color: #666;
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 600;
  }

  h1 {
    font-size: clamp(42px, 7vw, 68px);
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 20px 0;
  }

  .updated {
    color: #555;
    font-size: 13px;
    margin-bottom: 70px;
  }

  section {
    border-top: 1px solid #222;
    padding: 30px 0;
  }

  h2 {
    font-size: 18px;
    margin: 0 0 8px;
  }

  section p {
    color: #777;
    margin: 0;
    font-size: 16px;
  }
</style>
